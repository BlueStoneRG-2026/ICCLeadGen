# ICC Amazon File Desk production environment template.
# Copy to .env.production during deploy. Never commit the filled file.
# Values marked [required] must be supplied before production readiness passes.
# Values marked [optional] may be blank unless the runbook says otherwise.

###############################################################################
# Deployment target metadata (scripts only)
###############################################################################
# [required] Dedicated NEW Supabase project ref, e.g. abcdefghijklmnopqrst.
SUPABASE_PROJECT_REF=
# [required] Dedicated NEW Supabase project name. Must be icc-file-desk unless the runbook records an approved alternate.
SUPABASE_PROJECT_NAME=icc-file-desk
# [required] Dedicated NEW Netlify site ID. Get it from Netlify after creating the new site.
NETLIFY_SITE_ID=
# [required] Dedicated NEW Netlify site name. Must be icc-file-desk unless the runbook records an approved alternate.
NETLIFY_SITE_NAME=icc-file-desk
# [required] Live app origin for CORS. Use default Netlify URL first, then update to https://partners.ironcrowncapital.com after SSL is issued.
APP_ORIGIN=https://<new-site>.netlify.app

###############################################################################
# Frontend runtime
###############################################################################
# [required] Must be false in production.
VITE_DEMO_MODE=false
# [required] New dedicated Supabase project URL from Project Settings > API.
VITE_SUPABASE_URL=
# [required] New dedicated Supabase publishable/anon key from Project Settings > API.
VITE_SUPABASE_ANON_KEY=
# [required] Netlify Functions base path.
VITE_FUNCTION_BASE=/.netlify/functions

###############################################################################
# Supabase server-side runtime
###############################################################################
# [required] New dedicated Supabase project URL from Project Settings > API.
SUPABASE_URL=
# [required] New dedicated Supabase service-role key. Secret. Never expose client-side.
SUPABASE_SERVICE_ROLE_KEY=
# [required] New dedicated Supabase anon key. Same value as VITE_SUPABASE_ANON_KEY.
SUPABASE_ANON_KEY=
# [required] Private storage bucket created by migration 0001.
SUBMISSION_BUCKET=submission-files
# [optional] Timeout for Supabase API/storage calls.
SUPABASE_CALL_TIMEOUT_MS=8000

###############################################################################
# SendGrid transactional email
###############################################################################
# [required] Dedicated SendGrid API key with Mail Send permission.
SENDGRID_API_KEY=
# [required] Transactional sending domain. Domain authentication records come from SendGrid.
SENDING_DOMAIN=partners.ironcrowncapital.com
# [required] Branded sender identity for transactional email.
TRANSACTIONAL_FROM=Iron Crown File Desk <desk@partners.ironcrowncapital.com>
# [required] Reply-to inbox monitored by the operator/VA.
REPLY_TO_EMAIL=desk@partners.ironcrowncapital.com
# [required] One-click unsubscribe endpoint on the deployed Netlify site.
UNSUBSCRIBE_URL=https://<new-site>.netlify.app/.netlify/functions/unsubscribe
# [optional] VA queue notification email. Leave blank only if the admin dashboard is the sole queue.
VA_QUEUE_EMAIL=
# [optional] Timeout for SendGrid API calls.
SENDGRID_CALL_TIMEOUT_MS=8000
# [required] SendGrid Signed Event Webhook public verification key. Set as Supabase Edge secret.
SENDGRID_EVENT_PUBLIC_KEY=

###############################################################################
# DocuSign embedded ISO agreement
###############################################################################
# [required] Production DocuSign auth server. Demo value is not allowed for production.
DOCUSIGN_AUTH_SERVER=account.docusign.com
# [required] Production DocuSign eSignature REST base path.
DOCUSIGN_BASE_PATH=https://www.docusign.net/restapi
# [required] Dedicated DocuSign integration key for this project.
DOCUSIGN_INTEGRATION_KEY=
# [required] DocuSign API user GUID approved for JWT impersonation.
DOCUSIGN_USER_ID=
# [required] Dedicated RSA private key for this integration. Secret. Preserve line breaks as \n if needed.
DOCUSIGN_PRIVATE_KEY=
# [required] DocuSign production account ID.
DOCUSIGN_ACCOUNT_ID=
# [required] Dedicated ISO partner agreement template ID.
DOCUSIGN_ISO_TEMPLATE_ID=
# [required] Template role name matching the ISO template recipient role.
DOCUSIGN_TEMPLATE_ROLE_NAME=Signer1
# [required] Embedded signing return URL. Use default Netlify URL first, then custom domain after SSL.
DOCUSIGN_RETURN_URL=https://<new-site>.netlify.app/#portal
# [required] JSON map of DocuSign tab labels to app fields, or {"tabs": ...}.
DOCUSIGN_FIELD_MAP_JSON={}
# [optional] Local validity window for reusing active envelopes.
DOCUSIGN_ENVELOPE_VALID_DAYS=30
# [required] Dedicated DocuSign Connect HMAC secret. Set as Supabase Edge secret.
DOCUSIGN_CONNECT_HMAC_SECRET=
# [optional] Timeout for DocuSign API calls.
DOCUSIGN_CALL_TIMEOUT_MS=8000

###############################################################################
# Edge function and internal webhook secrets
###############################################################################
# [required] Netlify certified-email function URL used by DocuSign Connect Edge Function.
CERTIFIED_EMAIL_WEBHOOK_URL=https://<new-site>.netlify.app/.netlify/functions/certified-email
# [required] Random shared secret from DocuSign Edge Function to Netlify certified-email function.
INTERNAL_WEBHOOK_SECRET=
# [optional] Timeout for Edge Function outbound calls.
EXTERNAL_CALL_TIMEOUT_MS=8000
# [production safety] Must be unset/blank in production. Never set true.
ALLOW_UNSIGNED_WEBHOOKS=
# [production safety] Must be unset/blank in production. Never set true.
SUPABASE_FUNCTIONS_LOCAL=

###############################################################################
# Admin and underwriting
###############################################################################
# [required] Comma-separated Supabase Auth emails allowed into the admin dashboard.
ADMIN_EMAILS=
# [production safety] Must be unset/blank in production. Never set true.
LOCAL_ADMIN_BYPASS=
# [required] Operator underwriting intake mailbox for handoff package emails.
UNDERWRITING_INTAKE_EMAIL=
