# Frontend
VITE_DEMO_MODE=true
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_FUNCTION_BASE=/.netlify/functions
APP_ORIGIN=http://127.0.0.1:8888

# Supabase server-side
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUBMISSION_BUCKET=submission-files
SUPABASE_CALL_TIMEOUT_MS=8000

# Transactional email
SENDGRID_API_KEY=
SENDING_DOMAIN=partners.ironcrowncapital.com
TRANSACTIONAL_FROM=Iron Crown File Desk <desk@partners.ironcrowncapital.com>
REPLY_TO_EMAIL=desk@partners.ironcrowncapital.com
UNSUBSCRIBE_URL=
VA_QUEUE_EMAIL=
SENDGRID_CALL_TIMEOUT_MS=8000

# DocuSign
DOCUSIGN_AUTH_SERVER=account-d.docusign.com
DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_ISO_TEMPLATE_ID=
DOCUSIGN_TEMPLATE_ROLE_NAME=Signer1
DOCUSIGN_RETURN_URL=https://partners.ironcrowncapital.com/#portal
DOCUSIGN_FIELD_MAP_JSON={}
DOCUSIGN_ENVELOPE_VALID_DAYS=30
DOCUSIGN_CONNECT_HMAC_SECRET=
CERTIFIED_EMAIL_WEBHOOK_URL=https://your-netlify-site.netlify.app/.netlify/functions/certified-email
INTERNAL_WEBHOOK_SECRET=
DOCUSIGN_CALL_TIMEOUT_MS=8000
EXTERNAL_CALL_TIMEOUT_MS=8000

# SendGrid Event Webhook Edge Function
SENDGRID_EVENT_PUBLIC_KEY=
# Local Supabase webhook development only. Never set this in production.
ALLOW_UNSIGNED_WEBHOOKS=false
SUPABASE_FUNCTIONS_LOCAL=false

# Admin path
ADMIN_EMAILS=operator@example.com,va@example.com
# Local/dev only. Ignored on deployed Netlify environments.
LOCAL_ADMIN_BYPASS=false

# Underwriting handoff
UNDERWRITING_INTAKE_EMAIL=

# Local smoke flow only
LOCAL_FUNCTION_BASE=http://127.0.0.1:8888/.netlify/functions
ALLOW_NONLOCAL_FLOW=false
